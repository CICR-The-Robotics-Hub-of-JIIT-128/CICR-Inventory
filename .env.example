# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Never expose this key through a VITE_ variable or frontend bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Server-only Supabase Postgres connection string. Required to mirror auth password hashes.
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require
NEON_DATABASE_URL=postgresql://user:password@ep-example.neon.tech/neondb?sslmode=require

# Google SMTP (use a Gmail App Password, not your Google account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address
SMTP_PASS=your-16-character-google-app-password
SMTP_FROM=CICR Inventory <your-gmail-address>

# Deployment URL & OAuth Redirect Configuration
# Set both APP_URL and VITE_APP_URL to this deployment's public origin (for example https://inventory.cicr.in on a fork).
# Forks sharing the same database keep the identical Supabase and Neon variables above while overriding only these URL settings.
APP_URL=https://cicr-inventory.vercel.app
VITE_APP_URL=https://cicr-inventory.vercel.app
# Optional: Force a fixed Supabase OAuth and email verification redirect URL across non local hosts.
# Leave unset to automatically stay on whichever deployment origin the user signed in from (after allowing it in Supabase Auth -> URL Configuration -> Redirect URLs).
VITE_AUTH_REDIRECT_URL=
# Optional: Comma separated allowlist of authorized origins (for example https://inventory.cicr.in,https://cicr-inventory.vercel.app).
VITE_ALLOWED_ORIGINS=
