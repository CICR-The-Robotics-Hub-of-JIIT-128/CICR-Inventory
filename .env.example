# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Never expose this server key through frontend bundle defines or public variables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Server-only Supabase Postgres connection string. Required to mirror auth password hashes.
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require
NEON_DATABASE_URL=postgresql://user:password@ep-example.neon.tech/neondb?sslmode=require

# Google SMTP (use a Gmail App Password, not your Google account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address
SMTP_PASS=your-16-character-google-app-password
SMTP_FROM=CICR Inventory <your-gmail-address>

# Deployment URL & OAuth Redirect Configuration
# Set APP_URL to the canonical CICR public origin. Any *.vercel.app deployment automatically redirects here.
APP_URL=https://inventory.cicr.in
# Optional: Force a fixed Supabase OAuth and email verification redirect URL across non local hosts.
# Leave unset to automatically normalize www and legal prefixes onto https://inventory.cicr.in (after allowlisting in Supabase Auth -> URL Configuration -> Redirect URLs).
AUTH_REDIRECT_URL=
# Optional: Comma separated allowlist of non Vercel canonical origins (for example https://inventory.cicr.in).
ALLOWED_ORIGINS=
